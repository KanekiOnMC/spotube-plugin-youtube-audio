import "module:spotube" as spotube
import "module:std" as std

class Converter {
  static fun toSpotubeMatchObject(res) {
    return res.map((d) => {
      var m = Map()
      m["id"] = d["id"]
      m["title"] = d["title"]
      m["artists"] = [d["author"]]
      m["duration"] = d["duration"]
      m["thumbnail"] = d["thumbnail"]
      m["externalUri"] = "https://youtube.com/watch?v=" + d["id"]
      return m.toJson()
    }).toList()
  }
}

class AudioSourceEndpoint {
  var yt

  construct() {
    yt = spotube.YouTubeEngine()
  }

  get supportedPresets {
    var p1 = Map()
    p1["type"] = "lossy"
    p1["name"] = "mp4"
    p1["qualities"] = [
      { bitrate: 256000 },
      { bitrate: 128000 },
      { bitrate: 96000 },
      { bitrate: 44000 }
    ]

    var p2 = Map()
    p2["type"] = "lossy"
    p2["name"] = "webm"
    p2["qualities"] = [
      { bitrate: 256000 },
      { bitrate: 128000 },
      { bitrate: 96000 },
      { bitrate: 44000 }
    ]

    return [p1.toJson(), p2.toJson()]
  }
  
  fun matches(track) {
    final artists = track["artists"].map((a) => a["name"]).join(", ")
    final hasISRC = track["isrc"] != null && track["isrc"] != ""
    
    val query = hasISRC ? track["isrc"] : (track["name"] + " " + artists)

    return yt.search(query).then((res) {
      if (res.isEmpty && hasISRC) {
        return yt.search(track["name"] + " " + artists).then((res2) => Converter.toSpotubeMatchObject(res2))
      }
      return Converter.toSpotubeMatchObject(res)
    })
  }

  fun streams(match) {
    return yt.streamManifest(match["id"]).then((manifest) {
      var filtered = manifest.filter((stream) => stream["container"] == "webm")
      if (filtered.isEmpty) {
        filtered = manifest.filter((stream) => stream["container"] == "mp4")
      }
      if (filtered.isEmpty) {
        filtered = manifest
      }

      return filtered.map((stream) => {
        var sm = Map()
        sm["url"] = stream["url"]
        sm["container"] = stream["container"]
        sm["type"] = "lossless"
        sm["codec"] = stream["container"] == "webm" ? "opus" : "aac"
        sm["bitrate"] = stream["bitrate"]
        return sm.toJson()
      }).toList()
    })
  }
}

export { AudioSourceEndpoint }
