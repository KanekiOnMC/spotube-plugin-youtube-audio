import "module:spotube" as spotube
import "module:std" as std

class Converter {
  static fun toSpotubeMatchObject(res) {
    var list = []
    if (res == null) return list
    for (var d in res) {
      var map = Map()
      map["id"] = d["id"]
      map["title"] = d["title"]
      map["artists"] = [d["author"]]
      map["duration"] = d["duration"]
      map["thumbnail"] = d["thumbnail"]
      map["externalUri"] = "https://youtube.com/watch?v=" + d["id"]
      list.add(map)
    }
    return list
  }
}

class AudioSourceEndpoint {
  var yt

  construct() {
    yt = spotube.YouTubeEngine()
  }

  get supportedPresets {
    var p1 = Map()
    p1["type"] = "lossy"
    p1["name"] = "mp4"
    var q1 = Map()
    q1["bitrate"] = 256000
    p1["qualities"] = [q1]

    var p2 = Map()
    p2["type"] = "lossy"
    p2["name"] = "webm"
    var q2 = Map()
    q2["bitrate"] = 256000
    p2["qualities"] = [q2]

    return [p1, p2]
  }
  
  fun matches(track) {
    var artistsList = track["artists"]
    var artists = ""
    if (artistsList != null) {
      var names = []
      for (var a in artistsList) {
        names.add(a["name"])
      }
      artists = names.join(", ")
    }
    
    var isrc = track["isrc"]
    var hasISRC = isrc != null && isrc != ""
    var query = hasISRC ? isrc : (track["name"] + " " + artists)

    return yt.search(query).then((res) {
      if ((res == null || res.isEmpty) && hasISRC) {
        return yt.search(track["name"] + " " + artists).then((res2) {
          return Converter.toSpotubeMatchObject(res2)
        })
      }
      return Converter.toSpotubeMatchObject(res)
    })
  }

  fun streams(match) {
    return yt.streamManifest(match["id"]).then((manifest) {
      if (manifest == null) return []
      
      var filtered = []
      for (var stream in manifest) {
        if (stream["container"] == "webm") {
          filtered.add(stream)
        }
      }
      
      if (filtered.isEmpty) {
        for (var stream in manifest) {
          if (stream["container"] == "mp4") {
            filtered.add(stream)
          }
        }
      }

      if (filtered.isEmpty) {
        filtered = manifest
      }

      var result = []
      for (var stream in filtered) {
        var sm = Map()
        sm["url"] = stream["url"]
        sm["container"] = stream["container"]
        sm["type"] = "lossless"
        sm["codec"] = (stream["container"] == "webm") ? "opus" : "aac"
        sm["bitrate"] = stream["bitrate"]
        result.add(sm)
      }
      return result
    })
  }
}

export { AudioSourceEndpoint }
